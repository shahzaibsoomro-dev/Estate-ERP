+            label = "return" if kind == "investor" else "drawing"
+            _e(E, r["d"], f"{kind}_out", None, f"{kind.title()} {label} · {r['name']}", r["project_id"], r["name"],
+               [(payout, r["amount"], 0), ("1020", 0, r["amount"])])
