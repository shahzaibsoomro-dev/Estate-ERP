+    months: dict[str, dict] = {}
+    sources_in: dict[str, int] = {}
+    sources_out: dict[str, int] = {}
+    for e in entries:
+        cash = sum(d - c for a, d, c in e["lines"] if a in journal.CASH_ACCOUNTS)
+        if not cash:
+            continue
+        if e["date"] < start:
+            opening += cash
+            continue
+        label = journal.SOURCE_LABEL.get(e["source"], e["source"].replace("_", " ").title())
