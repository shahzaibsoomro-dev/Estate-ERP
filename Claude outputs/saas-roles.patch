+    # --- documents
+    ("POST", r"/api/document-templates/preview", ("documents",), "view"),
+    ("GET", r"/api/document-templates/\d+", ("documents",), "view"),
+    ("POST", r"/api/document-templates", ("documents",), "edit"),
+    ("PUT", r"/api/document-templates/\d+", ("documents",), "edit"),
