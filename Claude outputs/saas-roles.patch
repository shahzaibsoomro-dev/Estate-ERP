+    # --- lookups shared across pages
+    ("GET", r"/api/projects", ("*",), "view"),
+    ("GET", r"/api/settings", ("*",), "view"),
+    ("GET", r"/api/customers", ("customers", "booking", "recovery", "documents", "portal", "customer_logins", "units"), "view"),
+    ("GET", r"/api/agents", ("agents", "booking"), "view"),
