+.co-head h2{font-size:24px;letter-spacing:-.02em}
+.co-actions{display:flex;gap:8px;flex-wrap:wrap}
+.kv{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px}
+.kv div{background:var(--g50);border-radius:10px;padding:10px 12px}
+.kv span{display:block;font-size:11.5px;color:var(--g500)}
+.kv b{font-size:14px}
