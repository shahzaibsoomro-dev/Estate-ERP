+.plan-card{background:#fff;border:1px solid var(--g200);border-radius:var(--r);padding:20px;display:flex;flex-direction:column;gap:6px}
+.plan-card h3{font-size:17px}
+.plan-price{font-size:24px;font-weight:700;letter-spacing:-.02em}
+.plan-price span{font-size:13px;color:var(--g500);font-weight:500}
+.cn-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 14px}
+.cn-form-grid .full{grid-column:1/-1}
+.form-sec{font-size:11px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--g400);margin:6px 0 10px;grid-column:1/-1;border-top:1px solid var(--g100);padding-top:12px}
+.form-sec:first-child{border-top:0;padding-top:0}
+.form-err{background:var(--dangerp);color:#991B1B;border:1px solid #FECACA;border-radius:8px;padding:9px 12px;font-size:13px;margin-bottom:12px}
